# API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# LLM Configuration
LLM_PROVIDER=openai  # openai, ollama, vllm
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000

# TTS Configuration
TTS_PROVIDER=elevenlabs  # elevenlabs, openai

# Encryption Keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY=your_encryption_key_here

# Tenant Configuration
TENANT_CONFIG_DIR=./config/tenants

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, console

# Observability
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=voice-agent-platform
HELICONE_API_KEY=your_helicone_api_key_here

# Database (for session persistence)
DATABASE_URL=sqlite:///./data/sessions.db

# Security
ENABLE_TLS=true
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem
